# ─── Server ───────────────────────────────────────────
PORT=3000
ADMIN_PASSWORD=choose_a_strong_password

# ─── Bot protection ────────────────────────────────────
# Set both to "true" in Railway after deploying
REQUIRE_CLOUDFLARE=true
REQUIRE_FORM_TOKEN=true
# Secret used to sign form tokens — use a long random string
FORM_TOKEN_SECRET=replace_with_a_long_random_secret

# ─── Database (Railway provides this automatically) ───
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Resend (transactional email) ────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=you@yourdomain.com

# ─── Brevo (email marketing + contact sync) ───────────
# Account → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Brevo → Contacts → Lists → click your list → ID is in the URL
BREVO_LIST_ID=1

# ─── HubSpot ──────────────────────────────────────────
# Settings → Integrations → Private Apps → Create app
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#         crm.objects.deals.write, timeline
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Settings → Account Setup → Account Details → HubSpot Account ID
HUBSPOT_PORTAL_ID=12345678

# ─── Cloudinary (for grad order photo uploads) ────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Grad Admin Token ──────────────────────────────────
ADMIN_TOKEN=choose_a_strong_token

# ─── Clover ───────────────────────────────────────────
CLOVER_API_TOKEN=your_clover_api_token
CLOVER_MERCHANT_ID=your_16_char_merchant_id
CLOVER_APP_ID=your_app_id
CLOVER_APP_SECRET=your_app_secret

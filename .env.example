# ─── Server ───────────────────────────────────────────
PORT=3000
ADMIN_PASSWORD=<a long random string>

# ─── Bot protection ────────────────────────────────────
# Set both to "true" in Railway after deploying
REQUIRE_CLOUDFLARE=true
REQUIRE_FORM_TOKEN=true
# Secret used to sign form tokens — use a long random string
FORM_TOKEN_SECRET=<a long random string>

# ─── Database (Railway provides this automatically) ───
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# ─── Resend (transactional email) ────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=<re_... from Resend → API Keys>
NOTIFICATION_EMAIL=<the address that receives order alerts>

# ─── Brevo (email marketing + contact sync) ───────────
# Account → SMTP & API → API Keys
BREVO_API_KEY=<xkeysib-... from Brevo → SMTP & API → API Keys>
# Brevo → Contacts → Lists → click your list → ID is in the URL
BREVO_LIST_ID=1

# ─── HubSpot ──────────────────────────────────────────
# Settings → Integrations → Private Apps → Create app
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#         crm.objects.deals.write, timeline
HUBSPOT_ACCESS_TOKEN=<pat-na1-... from the Private App>
# Settings → Account Setup → Account Details → HubSpot Account ID
HUBSPOT_PORTAL_ID=12345678
# Off unless 1: send each quote-form enquiry to HubSpot. Brevo is the CRM.
HUBSPOT_SYNC_LEADS=

# ─── Cloudinary (for grad order photo uploads) ────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Grad Admin Token ──────────────────────────────────
ADMIN_TOKEN=<a long random string>

# ─── Clover ───────────────────────────────────────────
CLOVER_API_TOKEN=your_clover_api_token
CLOVER_MERCHANT_ID=your_16_char_merchant_id
CLOVER_APP_ID=your_app_id
CLOVER_APP_SECRET=your_app_secret
# Off unless 1: create a Clover customer for every quote-form enquiry.
# The payment webhook works either way.
CLOVER_SYNC_LEADS=

# ─── Stripe (card payments) ───────────────────────────
# Dashboard → Developers → API keys → Secret key. Without it the card buttons
# on quote pages (/q/:code/card) cannot make a checkout.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → this endpoint (https://<host>/webhooks/stripe)
# → Signing secret. Without it /webhooks/stripe answers 503 and no payment is
# booked from Stripe. Subscribe it to checkout, charge (incl. refunded) and dispute events.
STRIPE_WEBHOOK_SECRET=

# ─── Staff sign-in (Cloudflare Access) ────────────────
# The one login for /admin. Zero Trust → Settings → Custom pages shows the team
# domain (<team>.cloudflareaccess.com); the Access application's Overview shows
# its Application Audience (AUD) tag, 64 hex characters. OWNER_EMAILS is a
# comma-separated list. Missing or malformed on Railway, /health answers 503,
# so that deploy never goes live (the storefront keeps running on the last one).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
OWNER_EMAILS=

# ─── Sentry (error tracking) ──────────────────────────
# One shared Sentry org, one PROJECT per app — not one account per app.
# sentry.io → the "junes-tees" project → Settings → Client Keys (DSN).
# The DSN is not a secret (it ships in browser bundles by design) but it stays
# in the environment so staging and production cannot report as each other.
# Leave it unset and the app still records errors to app_errors and mails the
# hourly digest; only the Sentry half goes quiet.
# Shape: https://<publicKey>@o<orgId>.ingest.<region>.sentry.io/<projectId>
# Left blank on purpose — the radar gate refuses an env template that carries
# anything resembling a real value, and a DSN-shaped example is one.
SENTRY_DSN=
# Which deployment this is, as it appears in Sentry's environment selector.
# On Railway this is read from RAILWAY_ENVIRONMENT_NAME automatically — set it
# by hand only to override. Unset anywhere else means "development", so a
# laptop can never raise a production alert.
SENTRY_ENVIRONMENT=production

# Owner text alerts (new chat → text). All four needed; numbers in +1XXXXXXXXXX form.
TWILIO_ACCOUNT_SID=<twilio_account_sid>
TWILIO_AUTH_TOKEN=<twilio_auth_token>
TWILIO_PHONE_NUMBER=<twilio_sender_number>
TWILIO_TO_NUMBER=<owner_phone_number>
